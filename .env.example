# Server
PORT=3001

# Session (generate a long random string)
SESSION_SECRET=change_this_to_a_random_secret_string

# Chatwoot
CHATWOOT_API_TOKEN=your_chatwoot_api_token_here
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=2

# Portal public URL (used to build magic links)
PORTAL_URL=https://support.yourdomain.com

# SMTP (outgoing email for magic links)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=support@yourdomain.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=support@yourdomain.com
