</main>

<div id="toast-container" aria-live="polite"></div>

<script>
// ── Toast ─────────────────────────────────────────────────────────────
(function () {
  var TOAST_MSGS = {
    en: {
      tooLarge:        'File too large',
      tooLargeDetail:  'exceeds the 10 MB limit and was not added.',
      badType:         'File type not allowed',
      badTypeDetail:   'is not a supported format. Allowed: images, PDF, Word, Excel, TXT.',
      limitReached:    'File limit reached',
      limitDetail:     'You can attach up to 6 files per ticket.'
    },
    es: {
      tooLarge:        'Archivo muy grande',
      tooLargeDetail:  'supera el límite de 10 MB y no fue agregado.',
      badType:         'Tipo de archivo no permitido',
      badTypeDetail:   'no es un formato soportado. Permitidos: imágenes, PDF, Word, Excel, TXT.',
      limitReached:    'Límite de archivos alcanzado',
      limitDetail:     'Puedes adjuntar hasta 6 archivos por ticket.'
    }
  };

  window._toastMsgs = function () {
    var lang = (document.documentElement.lang || 'en').slice(0, 2);
    return TOAST_MSGS[lang] || TOAST_MSGS.en;
  };

  window.showFileToast = function (title, message) {
    var container = document.getElementById('toast-container');
    var toast = document.createElement('div');
    toast.className = 'toast toast-error';
    toast.innerHTML =
      '<div class="toast-icon">' +
        '<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">' +
          '<circle cx="12" cy="12" r="10"/>' +
          '<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01"/>' +
        '</svg>' +
      '</div>' +
      '<div class="toast-body">' +
        '<p class="toast-title">' + title + '</p>' +
        '<p class="toast-message">' + message + '</p>' +
      '</div>' +
      '<button class="toast-close" aria-label="Close">&times;</button>' +
      '<div class="toast-progress"></div>';

    toast.querySelector('.toast-close').addEventListener('click', function () {
      dismiss(toast);
    });
    container.appendChild(toast);
    requestAnimationFrame(function () { toast.classList.add('toast-show'); });
    toast._timer = setTimeout(function () { dismiss(toast); }, 5000);
  };

  function dismiss(toast) {
    clearTimeout(toast._timer);
    toast.classList.remove('toast-show');
    toast.classList.add('toast-hide');
    setTimeout(function () { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 350);
  }
})();

(function () {
  var MAX_FILES = 6;
  var MAX_SIZE  = 10 * 1024 * 1024; // 10 MB
  var ALLOWED = [
    'image/jpeg','image/png','image/gif','image/webp',
    'application/pdf',
    'application/msword',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
    'application/vnd.ms-excel',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    'text/plain'
  ];

  function getExt(name) {
    var parts = name.split('.');
    return parts.length > 1 ? parts.pop().toUpperCase().slice(0, 5) : 'FILE';
  }

  function initFileZone(zone) {
    var previewsEl = zone.querySelector('.file-previews');
    var footer     = zone.querySelector('.file-zone-footer');
    var addLabel   = zone.querySelector('.file-add-label');
    var input      = zone.querySelector('.file-input-hidden');
    var hintEl     = zone.querySelector('.file-zone-hint');
    var hintBase   = hintEl ? hintEl.textContent : '';
    if (!previewsEl || !input) return;

    var files = []; // accumulated File objects

    // Sync files array → input.files right before form submit
    var parentForm = zone.closest('form');
    if (parentForm) {
      parentForm.addEventListener('submit', function () {
        var dt = new DataTransfer();
        files.forEach(function (f) { dt.items.add(f); });
        input.files = dt.files;
      });
    }

    function render() {
      // Revoke old object URLs to avoid memory leaks
      previewsEl.querySelectorAll('img').forEach(function (img) {
        URL.revokeObjectURL(img.src);
      });
      previewsEl.innerHTML = '';

      files.forEach(function (f, i) {
        var item = document.createElement('div');
        item.className = 'file-preview-item';

        if (f.type.startsWith('image/')) {
          var img = document.createElement('img');
          img.src = URL.createObjectURL(f);
          img.className = 'file-preview-thumb';
          img.alt = f.name;
          item.appendChild(img);
        } else {
          var iconBox = document.createElement('div');
          iconBox.className = 'file-preview-icon';
          iconBox.innerHTML =
            '<svg width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">' +
            '<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>' +
            '</svg>' +
            '<span class="file-ext-badge">' + getExt(f.name) + '</span>';
          item.appendChild(iconBox);
        }

        var nameEl = document.createElement('p');
        nameEl.className = 'file-preview-name';
        nameEl.title = f.name;
        nameEl.textContent = f.name;
        item.appendChild(nameEl);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'file-remove-btn';
        btn.title = 'Remove';
        btn.innerHTML = '&times;';
        btn.addEventListener('click', (function (idx) {
          return function () {
            files.splice(idx, 1);
            render();
          };
        })(i));
        item.appendChild(btn);

        previewsEl.appendChild(item);
      });

      // Show/hide add button
      var atLimit = files.length >= MAX_FILES;
      if (addLabel) addLabel.style.display = atLimit ? 'none' : '';
      if (hintEl) {
        var rem = MAX_FILES - files.length;
        hintEl.textContent = atLimit
          ? hintBase
          : hintBase + (files.length > 0 ? ' · ' + rem + ' remaining' : '');
      }
    }

    function addFiles(newFiles) {
      var m = window._toastMsgs();
      Array.from(newFiles).forEach(function (f) {
        if (files.length >= MAX_FILES) {
          window.showFileToast(m.limitReached, m.limitDetail);
          return;
        }
        if (!ALLOWED.includes(f.type)) {
          window.showFileToast(m.badType, '\u201c' + f.name + '\u201d ' + m.badTypeDetail);
          return;
        }
        if (f.size > MAX_SIZE) {
          window.showFileToast(m.tooLarge, '\u201c' + f.name + '\u201d ' + m.tooLargeDetail);
          return;
        }
        var dup = files.some(function (e) { return e.name === f.name && e.size === f.size; });
        if (!dup) files.push(f);
      });
      render();
    }

    input.addEventListener('change', function () { addFiles(input.files); });

    // Drag and drop
    zone.addEventListener('dragover', function (e) {
      e.preventDefault();
      zone.classList.add('dragover');
    });
    zone.addEventListener('dragleave', function (e) {
      if (!zone.contains(e.relatedTarget)) zone.classList.remove('dragover');
    });
    zone.addEventListener('drop', function (e) {
      e.preventDefault();
      zone.classList.remove('dragover');
      addFiles(e.dataTransfer.files);
    });

    render();
  }

  document.querySelectorAll('.file-zone').forEach(initFileZone);
})();

// Lightbox
(function () {
  var overlay = document.getElementById('lb-overlay');
  if (!overlay) return;
  var lbImg    = document.getElementById('lb-img');
  var lbIframe = document.getElementById('lb-iframe');

  function openLb(url, type) {
    lbImg.style.display    = 'none';
    lbIframe.style.display = 'none';
    lbImg.src = '';
    lbIframe.src = '';
    if (type === 'image') {
      lbImg.src = url;
      lbImg.style.display = 'block';
    } else {
      lbIframe.src = url;
      lbIframe.style.display = 'block';
    }
    overlay.classList.add('lb-active');
    document.body.style.overflow = 'hidden';
  }

  function closeLb() {
    overlay.classList.remove('lb-active');
    lbImg.src = '';
    lbIframe.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.lb-trigger').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      openLb(el.href, el.dataset.lbType);
    });
  });

  overlay.querySelector('.lb-close').addEventListener('click', closeLb);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeLb();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeLb();
  });
})();

// Priority selector
(function () {
  var selector = document.getElementById('prioritySelector');
  var hidden   = document.getElementById('priorityInput');
  if (!selector || !hidden) return;

  selector.querySelectorAll('.prio-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      selector.querySelectorAll('.prio-btn').forEach(function (b) {
        b.classList.remove('prio-btn-active');
      });
      btn.classList.add('prio-btn-active');
      hidden.value = btn.dataset.value;
    });
  });
})();
</script>
</body>
</html>
