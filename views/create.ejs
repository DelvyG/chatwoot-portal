<%- include('_header', { pageTitle: t.createTicket }) %>

<div class="container container-narrow">
  <a href="<%= BASE %>/dashboard" class="back-link"><%= t.back %></a>

  <h1><%= t.createTicket %></h1>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="card">
    <form action="<%= BASE %>/tickets" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label><%= t.priorityLabel %></label>
        <div class="priority-selector">
          <label class="priority-opt priority-opt-low">
            <input type="radio" name="priority" value="low">
            <span class="priority-pip"></span><%= t.priorityLow %>
          </label>
          <label class="priority-opt priority-opt-medium">
            <input type="radio" name="priority" value="medium" checked>
            <span class="priority-pip"></span><%= t.priorityMedium %>
          </label>
          <label class="priority-opt priority-opt-high">
            <input type="radio" name="priority" value="high">
            <span class="priority-pip"></span><%= t.priorityHigh %>
          </label>
          <label class="priority-opt priority-opt-urgent">
            <input type="radio" name="priority" value="urgent">
            <span class="priority-pip"></span><%= t.priorityUrgent %>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label for="subject"><%= t.subjectLabel %></label>
        <input type="text" id="subject" name="subject"
               placeholder="<%= t.subjectPlaceholder %>" required>
      </div>
      <div class="form-group">
        <label for="message"><%= t.messageLabel %></label>
        <textarea id="message" name="message" rows="6"
                  placeholder="<%= t.messagePlaceholder %>" required></textarea>
      </div>
      <div class="form-group">
        <label><%= t.attachmentsLabel %></label>
        <div class="file-zone" id="createZone">
          <div class="file-previews"></div>
          <div class="file-zone-footer">
            <label class="file-add-label">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
              <%= t.addFiles %>
              <input type="file" name="attachments" multiple
                     accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt"
                     class="file-input-hidden">
            </label>
            <span class="file-zone-hint"><%= t.attachmentHint %></span>
          </div>
        </div>
      </div>
      <div class="form-actions">
        <a href="<%= BASE %>/dashboard" class="btn btn-ghost"><%= t.back %></a>
        <button type="submit" class="btn btn-primary"><%= t.submit %></button>
      </div>
    </form>
  </div>
</div>

<%- include('_footer') %>
